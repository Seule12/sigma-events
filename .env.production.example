# ============================================================
# SIGMA EVENTS — Variables d'environnement (production)
# Copier vers .env.production et remplir les valeurs
# ============================================================

# --- Base de données ---
DATABASE_URL="postgresql://sigma:MOT_DE_PASSE@localhost:5432/sigma_events?schema=public"
DIRECT_URL="postgresql://sigma:MOT_DE_PASSE@localhost:5432/sigma_events?schema=public"

# --- Application ---
NODE_ENV=production
APP_URL="https://sigma-events.com"

# --- FeexPay (paiement mobile money) ---
FEEXPAY_PRIVATE_KEY="fp_votre_cle_privee"
FEEXPAY_IDENTIFIER="votre_identifiant_marchand"
FEEXPAY_MODE="LIVE"

# --- Ably (temps réel) ---
ABLY_API_KEY="VOTRE_CLE_ABLY"

# --- Resend (email OTP) ---
RESEND_API_KEY="re_votre_cle_resend"

# --- Infobip (SMS fallback) ---
INFOBIP_API_KEY=""
INFOBIP_BASE_URL=""
INFOBIP_SENDER="SIGMA"

# --- WhatsApp Business API ---
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- Chiffrement QR ---
QR_ENCRYPTION_KEY="cle_hex_64_caracteres"

# --- FedaPay (retraits organisateurs) ---
FEDAPAY_PRIVATE_KEY=""
FEDAPAY_PUBLIC_KEY=""
FEDAPAY_MODE="PRODUCTION"

# --- CloudAMQP (file d'attente emails) ---
CLOUDAMQP_URL=""
