# ============================================================
# SIGMA EVENTS — Variables d'environnement pour LWS Cloud cPanel
# ============================================================
# Copiez ce fichier en .env.production et remplissez les valeurs.
# ============================================================

# --- Base de données MySQL ---
# Format : mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Trouvez ces infos dans cPanel > MySQL Databases
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DB_NAME"

# --- Authentification ---
# Générez avec : openssl rand -base64 32
AUTH_SECRET="REMPLACER_PAR_UN_SECRET_ALEATOIRE"

# --- FeexPay (Paiement) ---
FEEXPAY_API_KEY="VOTRE_CLE_API_FEEXPAY"
FEEXPAY_API_SECRET="VOTRE_CLE_API_SECRET_FEEXPAY"
FEEXPAY_WEBHOOK_SECRET="VOTRE_SECRET_WEBHOOK_FEEXPAY"
NEXT_PUBLIC_FEEXPAY_PUBLIC_KEY="VOTRE_CLE_PUBLIQUE_FEEXPAY"

# --- Ably (Temps réel / Scanner) -->
ABLY_API_KEY="VOTRE_CLE_API_ABLY"

# --- Resend (Emails) ---
RESEND_API_KEY="re_VOTRE_CLE_RESEND"
RESEND_FROM="Sigma Events <noreply@getsigmaevents.com>"

# --- CloudAMQP (Worker emails) ---
CLOUDAMQP_URL="amqp://USER:PASSWORD@HOST/VHOST"

# --- WhatsApp (Meta Business API) ---
WHATSAPP_PHONE_NUMBER_ID="VOTRE_PHONE_NUMBER_ID"
WHATSAPP_ACCESS_TOKEN="VOTRE_ACCESS_TOKEN_META"
WHATSAPP_VERIFY_TOKEN="sigma_events_verify_2026"

# --- Next.js ---
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://getsigmaevents.com"
