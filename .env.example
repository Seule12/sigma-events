# Resend — envoi des emails transactionnels (OTP, billet, facture)
# Créer une clé : resend.com → API Keys. EMAIL_FROM doit être un domaine vérifié ;
# pour un premier test sans domaine, utiliser : EMAIL_FROM="Acme <onboarding@resend.dev>"
# (envoi limité à l'adresse du compte Resend lui-même).
RESEND_API_KEY="re_SuAEZ8TR_3WRd6aU4Hdx41WPHzkxnBFFU"
