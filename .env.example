# Base de données SQLite (chemin relatif au dossier du projet)
# Dev local + tests : SQLite (défaut)
# DATABASE_URL="file:./dev.db"
#
# Production : PostgreSQL (Supabase) — chaîne de connexion COMPLÈTE du dashboard
# Supabase → Settings → Database → Connection string → URI (format postgresql://…).
# NB : l'URL du projet (https://xxx.supabase.co) et la PUBLISHABLE_KEY ne sont PAS
# une chaîne Prisma — elles servent au client Supabase (API REST), pas à Prisma.
# À remplacer par la vraie chaîne avant le déploiement.
DATABASE_URL="file:./dev.db"

# Base de données Supabase (chemin relatif au dossier du projet)
DATABASE_URL="https://jrhhkadwhsuqlbnrvpsv.supabase.co"
PUBLISHABLE_KEY="sb_publishable_jmnqfj0F-NoIBj4I10HMFw_5gH-iJX5"


# URL publique de l'application (liens QR + redirections OAuth)
# En local : http://localhost:3000 — En production : https://votre-domaine.com
APP_URL="http://localhost:3000"

# Ably — notifications temps réel (canal privé par utilisateur + événements)
