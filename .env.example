WHATSAPP_PHONE_NUMBER_ID=""
# Token de vérification du webhook (défini dans Meta Dashboard → WhatsApp → Configuration)
WHATSAPP_VERIFY_TOKEN=""

# ============================================================
# Connexion sociale (OAuth 2.0) — Google / Facebook / Apple
# Tant qu'une clé est vide, le bouton correspondant reste grisé.
# ============================================================

# Google — console.cloud.google.com → Identifiants → ID client OAuth (Application Web)
# URI de redirection autorisée : <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID="712981999496-n1kr6ifnkceca5sbr4k8rm3vhpb1cikp.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"

# Facebook — developers.facebook.com → votre app → Paramètres → Base
# URI de redirection OAuth : <APP_URL>/api/auth/facebook/callback
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ============================================================
# FedaPay — Payouts (retraits des organisateurs)
# Clé secrète API (sk_…) : dashboard FedaPay → API Keys.
# FEDAPAY_ENV="sandbox" (défaut, aucun fonds réel) ou "live" (virements réels).
# Sans clé, le bouton « Valider et verser » de /admin/retraits est bloqué.
# ============================================================
FEDAPAY_SECRET_KEY=""
FEDAPAY_ENV="sandbox"

# Seuil (FCFA) au-delà duquel un retrait confirmé par code (OTP) nécessite EN PLUS
# la validation d'un super admin (double sécurité pour les gros montants).
# Défaut : 100 000 FCFA.
PAYOUT_ADMIN_THRESHOLD="100000"

