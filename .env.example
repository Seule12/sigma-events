# ============================================================
# Paiement mobile money réel (FeexPay — feexpay.me)
# Sans clés : paiement simulé (mode démo, aucun débit réel).
# Avec : le client est redirigé vers la page de paiement FeexPay
# (MTN MoMo / Moov Money / Celtiis Cash / cartes bancaires),
# et le webhook /api/webhook/feexpay confirme le paiement.
# ============================================================
# Clé privée et identifiant marchand : dashboard feexpay.me → Clés API
FEEXPAY_PRIVATE_KEY="fp_Xcl3090aU2vQYD65ZFnGDCRdRIxX3btOk9nkmHYzg8xRPpsxmevFBGMsroUUdY7l"
FEEXPAY_IDENTIFIER="UjCyDv7hL7oJBAE"
# Mode : LIVE (production) ou SANDBOX (tests). Défaut : LIVE.
FEEXPAY_MODE="LIVE"

# ============================================================
# SMS réel (Infobip) — codes OTP inscription / récupération de code / retrait
# Sans clés : mode dégradé (le code est journalisé côté serveur, jamais exposé).
# ============================================================
# portal.infobip.com → Channels → API keys (et votre base URL régionale)
INFOBIP_API_KEY=""
INFOBIP_BASE_URL="xxx.api.infobip.com"
# Expéditeur SMS affiché (nom court) — certains opérateurs exigent un numéro
INFOBIP_SENDER="SIGMA"

# ============================================================
# WhatsApp automatisé (Meta API Business Cloud)
# Sans clés : les liens wa.me restent utilisés (partage manuel).
# Avec : le billet / l'invitation est envoyé automatiquement au client.
# ============================================================
# developers.facebook.com → votre app Business → WhatsApp → Configuration de l'API
